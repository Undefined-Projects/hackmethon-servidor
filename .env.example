# ═══════════════════════════════════════════════════════════════
#  ⚠ SIN COMILLAS AL PEGAR EN VERCEL
#
#  En el panel de Vercel el valor se pega tal cual, así que unas
#  comillas se vuelven parte del texto y rompen la comparación.
#  Aquí van sin comillas justamente para que se copien bien.
#  (Si haces un .env.local para desarrollo, ahí sí puedes usarlas.)
# ═══════════════════════════════════════════════════════════════

# ── Base de datos ────────────────────────────────────────────
# Vercel la inyecta sola al conectar Neon desde el Marketplace.
DATABASE_URL=postgres://usuario:clave@host/basededatos?sslmode=require

# ── Quién puede llamar a esta API ────────────────────────────
# La portada vive en GitHub Pages y la API en Vercel, así que son dominios
# distintos. Sin esta variable el navegador bloquea todos los registros.
# Separados por coma. Con o sin espacios da igual, con barra final también.
ORIGENES_PERMITIDOS=https://undefinedclub.org,https://www.undefinedclub.org

# ── Panel de participantes ───────────────────────────────────
# La contraseña para entrar a admin.html. Genérala con:
#   openssl rand -base64 32
ADMIN_TOKEN=cambia-esto-por-algo-largo-y-aleatorio

# ── Cupo ─────────────────────────────────────────────────────
# Solo el valor INICIAL. En cuanto lo cambies desde el panel, el número vive
# en la base de datos y esta variable deja de usarse.
CUPO_EQUIPOS=10

# ── Correo de aviso (opcional) ───────────────────────────────
# Si faltan estas tres, el registro se guarda igual y solo no se manda correo.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
CORREO_REGISTROS=contacto@undefinedclub.org
CORREO_REMITENTE=HACK(ME)THON <registro@undefinedclub.org>
